{
  "name": "claude-tokensaver",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code mod that routes sub-agents to the cheapest capable model tier, escalates on failure, and shows live token savings.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types:sync": "node scripts/sync-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mod": "claude plugin test .",
    "validate": "claude plugin validate . --strict",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "preview": "node scripts/render-preview.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run validate && npm run test:mod && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
